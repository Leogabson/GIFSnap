# Vercel Blob storage read/write token (used for storing converted stickers and MP4 clips)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST token for rate limiting
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile public site key for bot verification
TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key for server-side verification
TURNSTILE_SECRET_KEY=

# Telegram Bot API token for the bot interface
TELEGRAM_BOT_TOKEN=

# Secret token to authenticate incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# Secret used to secure cron maintenance endpoints
CRON_SECRET=

# Secret required to access the temporary feasibility spike endpoint (/api/spike)
SPIKE_SECRET=
